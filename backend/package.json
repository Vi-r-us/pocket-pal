{
  "name": "pocketpal-backend",
  "version": "0.1.0",
  "description": "Backend for PocketPal, a scalable personal finance app for budgeting, transaction tracking, and bank integration.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon -r dotenv/config src/index.js",
    "start": "node src/index.js",
    "test": "node -e \"process.exit(0)\"",
    "lint": "eslint src --max-warnings 0",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all --config src/config/env.config.js --seeders-path src/seeders",
    "seed:mock-tx": "node -r dotenv/config scripts/seed-mock-transactions.js",
    "seed:budget-may": "node -r dotenv/config scripts/seed-budget-may.js",
    "seed:may-tx": "node -r dotenv/config scripts/seed-may-transactions.js",
    "repair:savings-balances": "node -r dotenv/config scripts/repair-savings-balances.js"
  },
  "keywords": [
    "personal-finance",
    "budgeting",
    "transaction-tracking",
    "node",
    "express"
  ],
  "author": "PocketPal Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
