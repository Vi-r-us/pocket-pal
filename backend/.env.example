# Local: use either discrete Postgres vars OR DATABASE_URL (not both required; DATABASE_URL wins if set).

# Option A — discrete (e.g. docker-compose Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE=pocket_pal_db

# Option B — single URL (Neon, Render, etc.)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# App
NODE_ENV=development
PORT=8000

# CORS: your frontend origin (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# JWT (use strong random values in production)
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Cross-site auth cookies (Vercel frontend + Render API). Auto-enabled in production.
# AUTH_COOKIE_CROSS_SITE=false

# Logging
# LOG_LEVEL=info
# LOG_BATCH_INTERVAL_MS=2000
# LOG_BATCH_SIZE=100

# Budget FX: period_end | period_start
# BUDGET_FX_AS_OF=period_end

# Cloudinary (if using uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# CI / tests
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/pocketpal_test
