# Local: use either discrete Postgres vars OR DATABASE_URL (not both required; DATABASE_URL wins if set).

# Option A — discrete (e.g. docker-compose Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE=pocket_pal_db

# Option B — single URL (Neon, Render, etc.)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# App
NODE_ENV=development
PORT=8000

# CORS: your frontend origin
CORS_ORIGIN=http://localhost:5173

# JWT (use strong random values in production)
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh

# Optional
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d
# LOG_LEVEL=info

# Cloudinary (if using uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# CI / tests
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/pocketpal_test
