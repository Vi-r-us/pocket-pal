# PocketPal Frontend — copy to .env for local development

# Logical environment: development | preview | production
VITE_APP_ENV=development

# Backend API base URL (no trailing slash). Empty = same origin as the SPA.
VITE_API_URL=http://localhost:8000

# API path prefix
VITE_API_PREFIX=api/v1

# Optional client-side error reporting endpoint
# VITE_ERROR_REPORT_URL=
